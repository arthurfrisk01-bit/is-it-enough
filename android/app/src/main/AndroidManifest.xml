<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      UsageStatsManager：需要用户前往系统“使用情况访问”手动授权，
      PACKAGE_USAGE_STATS 是 signature|privileged 权限，不能仅靠安装时授予。
      tools:ignore 用于压制 IDE 对受保护权限的误报。
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 全局悬浮窗：原生提醒窗口 ReminderOverlay（TYPE_APPLICATION_OVERLAY）需要 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 8+ 后台前台服务，用于保持轮询监听 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 13+ 通知权限，辅助提醒/后台保活通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 强提醒全屏通知（锁屏时悬浮窗不可见，由系统全屏 Intent 兜底） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
      检查更新需要访问 GitHub Releases（唯一联网功能，默认不自动执行）。
      其余所有数据仍只存在本机，不上传。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 开机自启（可选，用于重启后恢复监听） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 9 及以下导出日志到公共“下载”目录需要；10+ 走 MediaStore 无需此权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name="${applicationName}"
        android:label="够了吗"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/LaunchTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Flutter 引擎相关 meta-data -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!--
          后台监控保活服务：
          - 常驻低优先级前台通知，提升进程优先级，降低被回收概率；
          - App 界面不存在时（开机自启 / 进程被系统回收后重建）拉起无界面
            Flutter 引擎执行 monitorMain 入口，让监控继续工作。
        -->
        <service
            android:name=".MonitorForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="持续读取应用使用时长并在超时后提醒用户，属用户主动开启的数字健康守护功能" />
        </service>

        <!-- 开机 / 应用更新后按开关自动恢复后台监控 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

    <queries>
        <!-- 用于 android_intent_plus 跳转系统设置/厂商页面 -->
        <intent>
            <action android:name="android.settings.USAGE_ACCESS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" />
        </intent>
        <!--
          包可见性（Android 11+ / targetSdk 30+）：不声明的话
          PackageManager.getApplicationInfo(其他应用包名) 会抛 NameNotFoundException，
          导致提醒里只能显示包名而不是「微信」。
          这里声明“带桌面图标的应用”这一常见 intent，即可看到所有用户可见的应用，
          无需申请受 Google Play 严格限制的 QUERY_ALL_PACKAGES。
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
